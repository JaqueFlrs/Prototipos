<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GM Mis Viajes – Liquidaciones</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --orange: #F47B20;
    --orange-light: #FFF0E5;
    --green: #22C55E;
    --green-light: #DCFCE7;
    --yellow: #F59E0B;
    --yellow-light: #FEF3C7;
    --red: #EF4444;
    --red-light: #FEE2E2;
    --gray-50: #F9FAFB;
    --gray-100: #F3F4F6;
    --gray-200: #E5E7EB;
    --gray-400: #9CA3AF;
    --gray-600: #4B5563;
    --gray-800: #1F2937;
    --font: 'Nunito', sans-serif;
  }

  body {
    font-family: var(--font);
    background: #E8EAF0;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 24px;
  }

  /* Phone shell */
  .phone {
    width: 375px;
    height: 812px;
    background: var(--gray-50);
    border-radius: 44px;
    box-shadow: 0 30px 80px rgba(0,0,0,.25), 0 0 0 10px #1a1a1a, 0 0 0 12px #333;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  /* Status bar */
  .status-bar {
    background: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px 6px;
    font-size: 12px;
    font-weight: 700;
    color: var(--gray-800);
    flex-shrink: 0;
  }
  .status-icons { display: flex; gap: 6px; align-items: center; font-size: 11px; }

  /* Header */
  .header {
    background: white;
    padding: 10px 20px 14px;
    display: flex;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid var(--gray-200);
    flex-shrink: 0;
  }
  .back-btn {
    color: var(--orange);
    font-size: 20px;
    cursor: pointer;
    line-height: 1;
  }
  .header-icon {
    width: 42px; height: 42px;
    background: var(--orange);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
  }
  .header-text h1 { font-size: 17px; font-weight: 800; color: var(--gray-800); }
  .header-text p  { font-size: 11px; color: var(--gray-400); font-weight: 600; margin-top: 1px; }

  /* Tabs */
  .tabs {
    background: white;
    display: flex;
    padding: 0 20px;
    border-bottom: 2px solid var(--gray-200);
    flex-shrink: 0;
  }
  .tab {
    flex: 1;
    text-align: center;
    padding: 11px 0;
    font-size: 13px;
    font-weight: 700;
    color: var(--gray-400);
    cursor: pointer;
    border-bottom: 2.5px solid transparent;
    margin-bottom: -2px;
    transition: all .2s;
  }
  .tab.active { color: var(--orange); border-bottom-color: var(--orange); }

  /* Content scroll */
  .content {
    flex: 1;
    overflow-y: auto;
    padding: 14px 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .content::-webkit-scrollbar { display: none; }

  /* ── RECIENTES ── */
  .recent-card {
    background: white;
    border-radius: 16px;
    padding: 14px 16px;
    box-shadow: 0 2px 8px rgba(0,0,0,.06);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .recent-card-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .recent-icon {
    width: 38px; height: 38px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .recent-icon.orange { background: var(--orange-light); }
  .recent-icon.blue   { background: #EFF6FF; }
  .recent-title { font-size: 14px; font-weight: 800; color: var(--gray-800); }
  .recent-sub   { font-size: 11px; color: var(--gray-400); font-weight: 600; margin-top: 1px; }
  .chevron { margin-left: auto; color: var(--gray-400); font-size: 16px; }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--orange-light);
    color: var(--orange);
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
    font-family: var(--font);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    width: fit-content;
  }
  .btn-open {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: var(--green-light);
    color: var(--green);
    border: none;
    border-radius: 10px;
    padding: 10px;
    font-family: var(--font);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    width: 100%;
  }

  /* ── TODAS – toolbar ── */
  .toolbar {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
    padding: 10px 16px 2px;
    background: var(--gray-50);
  }
  .search-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    background: white;
    border: 1.5px solid var(--gray-200);
    border-radius: 10px;
    padding: 0 10px;
    gap: 6px;
    height: 36px;
  }
  .search-wrap input {
    border: none; outline: none;
    font-family: var(--font);
    font-size: 12px;
    color: var(--gray-800);
    font-weight: 600;
    width: 100%;
    background: transparent;
  }
  .search-wrap input::placeholder { color: var(--gray-400); font-weight: 600; }
  .search-icon { color: var(--gray-400); font-size: 14px; }

  .filter-btn {
    width: 36px; height: 36px;
    background: white;
    border: 1.5px solid var(--gray-200);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 15px;
    cursor: pointer;
    color: var(--orange);
    flex-shrink: 0;
  }
  .filter-btn.active { background: var(--orange); color: white; border-color: var(--orange); }

  /* Filter panel */
  .filter-panel {
    background: white;
    border-bottom: 1px solid var(--gray-200);
    padding: 10px 16px 12px;
    display: none;
    flex-direction: column;
    gap: 8px;
    flex-shrink: 0;
  }
  .filter-panel.open { display: flex; }
  .filter-row { display: flex; gap: 8px; }
  .filter-row label { font-size: 10px; font-weight: 700; color: var(--gray-600); display: block; margin-bottom: 2px; }
  .filter-row select, .filter-row input[type=date] {
    width: 100%;
    font-family: var(--font);
    font-size: 11px;
    border: 1.5px solid var(--gray-200);
    border-radius: 8px;
    padding: 5px 8px;
    color: var(--gray-800);
    font-weight: 600;
    background: var(--gray-50);
    outline: none;
  }
  .filter-col { flex: 1; }

  /* Liq cards */
  .liq-card {
    background: white;
    border-radius: 14px;
    padding: 13px 14px;
    box-shadow: 0 2px 8px rgba(0,0,0,.05);
    cursor: pointer;
    transition: transform .15s, box-shadow .15s;
  }
  .liq-card:active { transform: scale(.98); box-shadow: 0 1px 4px rgba(0,0,0,.08); }
  .liq-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }
  .folio { font-size: 14px; font-weight: 800; color: var(--gray-800); }
  .badge {
    font-size: 10px;
    font-weight: 700;
    border-radius: 20px;
    padding: 3px 9px;
  }
  .badge.green  { background: var(--green-light);  color: #15803D; }
  .badge.yellow { background: var(--yellow-light); color: #92400E; }
  .badge.red    { background: var(--red-light);    color: #991B1B; }

  .liq-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5px 10px;
  }
  .liq-field label { font-size: 9px; font-weight: 700; color: var(--gray-400); text-transform: uppercase; letter-spacing: .4px; display: block; }
  .liq-field span  { font-size: 12px; font-weight: 700; color: var(--gray-800); }
  .liq-field.full  { grid-column: 1 / -1; }
  .neto { color: var(--orange) !important; font-size: 13px !important; }

  .divider { height: 1px; background: var(--gray-100); margin: 8px 0; }

  /* Empty / error */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    gap: 10px;
    color: var(--gray-400);
    font-size: 13px;
    font-weight: 700;
    text-align: center;
  }
  .empty-state .icon { font-size: 38px; }

  /* hidden */
  .pane { display: none; flex-direction: column; height: 100%; }
  .pane.active { display: flex; }
</style>
</head>
<body>
<div class="phone">

  <!-- Status bar -->
  <div class="status-bar">
    <span>3:49</span>
    <div class="status-icons">
      <span>🔕</span><span>WiFi</span><span>📶</span><span style="background:var(--orange);color:white;border-radius:4px;padding:1px 5px">73</span>
    </div>
  </div>

  <!-- Header -->
  <div class="header">
    <span class="back-btn">←</span>
    <div class="header-icon">📋</div>
    <div class="header-text">
      <h1>Liquidaciones</h1>
      <p>Consulta y descarga tus liquidaciones</p>
    </div>
  </div>

  <!-- Tabs -->
  <div class="tabs">
    <div class="tab active" id="tab-recientes" onclick="switchTab('recientes')">Recientes</div>
    <div class="tab" id="tab-todas" onclick="switchTab('todas')">Todas</div>
  </div>

  <!-- ══ PANE: Recientes ══ -->
  <div class="pane active" id="pane-recientes">
    <div class="content">
      <!-- Última -->
      <div class="recent-card">
        <div class="recent-card-top">
          <div class="recent-icon orange">📄</div>
          <div>
            <div class="recent-title">Última Liquidación</div>
            <div class="recent-sub">Liquidación más reciente disponible</div>
          </div>
          <span class="chevron">›</span>
        </div>
        <button class="btn-download">⬇ Toca para descargar</button>
        <button class="btn-open">📕 Abrir PDF descargado ↗</button>
      </div>

      <!-- Penúltima -->
      <div class="recent-card">
        <div class="recent-card-top">
          <div class="recent-icon blue">🕐</div>
          <div>
            <div class="recent-title">Penúltima Liquidación</div>
            <div class="recent-sub">Liquidación anterior para respaldo</div>
          </div>
          <span class="chevron">›</span>
        </div>
        <button class="btn-download">⬇ Toca para descargar</button>
        <button class="btn-open">📕 Abrir PDF descargado ↗</button>
      </div>
    </div>
  </div>

  <!-- ══ PANE: Todas ══ -->
  <div class="pane" id="pane-todas">
    <!-- Toolbar -->
    <div class="toolbar">
      <div class="search-wrap">
        <span class="search-icon">🔍</span>
        <input type="text" placeholder="Buscar por folio..." id="search-input" oninput="filterCards()">
      </div>
      <button class="filter-btn" id="filter-toggle" onclick="toggleFilter()">⚙</button>
    </div>

    <!-- Filter panel -->
    <div class="filter-panel" id="filter-panel">
      <div class="filter-row">
        <div class="filter-col">
          <label>Fecha inicial</label>
          <input type="date" id="f-fecha-ini" onchange="filterCards()">
        </div>
        <div class="filter-col">
          <label>Fecha final</label>
          <input type="date" id="f-fecha-fin" onchange="filterCards()">
        </div>
      </div>
      <div class="filter-row">
        <div class="filter-col">
          <label>Moneda</label>
          <select id="f-moneda" onchange="filterCards()">
            <option value="">Todas</option>
            <option value="MXN">MXN</option>
            <option value="USD">USD</option>
          </select>
        </div>
        <div class="filter-col">
          <label>Estatus</label>
          <select id="f-estatus" onchange="filterCards()">
            <option value="">Todos</option>
            <option value="Pagada">Pagada</option>
            <option value="Autorizada">Autorizada</option>
            <option value="Sin autorizar">Sin autorizar</option>
          </select>
        </div>
      </div>
    </div>

    <!-- List -->
    <div class="content" id="liq-list"></div>
  </div>

</div>

<script>
const DATA = [
  { folio:"LIQ-1248", fechaIni:"01/03/2025", fechaFin:"31/03/2025", estatus:"Pagada",       moneda:"MXN", neto:"$12,500.00 MXN", fechaPago:"05/04/2025" },
  { folio:"LIQ-1240", fechaIni:"01/02/2025", fechaFin:"28/02/2025", estatus:"Autorizada",   moneda:"MXN", neto:"$11,800.00 MXN", fechaPago:"" },
  { folio:"LIQ-1235", fechaIni:"01/01/2025", fechaFin:"31/01/2025", estatus:"Sin autorizar",moneda:"USD", neto:"$1,200.00 USD",  fechaPago:"" },
  { folio:"LIQ-1228", fechaIni:"01/12/2024", fechaFin:"31/12/2024", estatus:"Pagada",       moneda:"MXN", neto:"$13,200.00 MXN", fechaPago:"07/01/2025" },
  { folio:"LIQ-1219", fechaIni:"01/11/2024", fechaFin:"30/11/2024", estatus:"Autorizada",   moneda:"USD", neto:"$980.00 USD",    fechaPago:"" },
  { folio:"LIQ-1210", fechaIni:"01/10/2024", fechaFin:"31/10/2024", estatus:"Pagada",       moneda:"MXN", neto:"$10,400.00 MXN", fechaPago:"06/11/2024" },
];

const badgeClass = { "Pagada":"green", "Autorizada":"yellow", "Sin autorizar":"red" };

function renderCard(d) {
  return `
  <div class="liq-card" onclick="downloadPDF('${d.folio}')">
    <div class="liq-card-top">
      <span class="folio">${d.folio}</span>
      <span class="badge ${badgeClass[d.estatus]}">${d.estatus}</span>
    </div>
    <div class="liq-fields">
      <div class="liq-field">
        <label>Fecha Inicial</label>
        <span>${d.fechaIni}</span>
      </div>
      <div class="liq-field">
        <label>Fecha Final</label>
        <span>${d.fechaFin}</span>
      </div>
      <div class="liq-field full">
        <div class="divider"></div>
      </div>
      <div class="liq-field">
        <label>Neto a pagar</label>
        <span class="neto">${d.neto}</span>
      </div>
      <div class="liq-field">
        <label>Fecha de pago</label>
        <span>${d.fechaPago || '—'}</span>
      </div>
    </div>
  </div>`;
}

function renderList(items) {
  const list = document.getElementById('liq-list');
  if (items.length === 0) {
    list.innerHTML = `<div class="empty-state"><span class="icon">🗂️</span><span>No se encontraron liquidaciones</span></div>`;
  } else {
    list.innerHTML = items.map(renderCard).join('');
  }
}

function filterCards() {
  const q   = document.getElementById('search-input').value.toLowerCase();
  const mon = document.getElementById('f-moneda').value;
  const est = document.getElementById('f-estatus').value;

  const filtered = DATA.filter(d => {
    if (q   && !d.folio.toLowerCase().includes(q)) return false;
    if (mon && d.moneda !== mon) return false;
    if (est && d.estatus !== est) return false;
    return true;
  });
  renderList(filtered);
}

function toggleFilter() {
  const panel = document.getElementById('filter-panel');
  const btn   = document.getElementById('filter-toggle');
  const open  = panel.classList.toggle('open');
  btn.classList.toggle('active', open);
}

function switchTab(tab) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.pane').forEach(p => p.classList.remove('active'));
  document.getElementById('tab-' + tab).classList.add('active');
  document.getElementById('pane-' + tab).classList.add('active');
  if (tab === 'todas') renderList(DATA);
}

function downloadPDF(folio) {
  alert(`Descargando PDF de ${folio}...\nGET /api/getformatoliquidacion`);
}

// init
renderList(DATA);
</script>
</body>
</html>
