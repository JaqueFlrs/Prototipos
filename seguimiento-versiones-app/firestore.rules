rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email;
    }

    // Defensa en profundidad además de la restricción en el login (Google Sign-In):
    // ningún doc de este sistema es legible sin correo @gmtransporterp.com.
    function isCompanyEmail() {
      return signedIn() && email().matches('.*@gmtransporterp[.]com$');
    }

    function usuarioDoc() {
      return get(/databases/$(database)/documents/usuarios/$(email()));
    }

    // Provisionado = tiene doc en `usuarios` (lo crea el super admin desde Administración).
    // Esta es la autorización real de la app — el login por sí solo no basta.
    function isProvisioned() {
      return isCompanyEmail() && exists(/databases/$(database)/documents/usuarios/$(email()));
    }

    function isSuperAdmin() {
      return isProvisioned() && usuarioDoc().data.rol == 'super';
    }

    // Espejo de solo lectura de Zoho. Solo Cloud Functions (Admin SDK) escriben aquí.
    match /tickets/{ticketId} {
      allow read: if isProvisioned();
      allow write: if false;
    }

    match /hus/{huId} {
      allow read: if isProvisioned();
      allow write: if false;
    }

    match /releases/{releaseId} {
      allow read: if isProvisioned();
      allow write: if false;
    }

    // Seguimiento manual rápido (bitácora) — sí se escribe desde el cliente.
    match /bitacoras/{taskId}/entries/{entryId} {
      allow read: if isProvisioned();
      allow create: if isProvisioned() && request.resource.data.userEmail == email();
      allow update, delete: if isSuperAdmin() || (isProvisioned() && resource.data.userEmail == email());
    }

    // Solo puede tocar su propia `fotoURL`, nada de rol/permisos (eso es solo super admin).
    function soloActualizaFoto() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fotoURL']);
    }

    // Provisionamiento de usuarios/roles — solo el super admin gestiona a otros.
    // Doc ID = correo del usuario (así no depende de saber su uid de antemano).
    match /usuarios/{userEmail} {
      allow read: if signedIn() && (email() == userEmail || isSuperAdmin());
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isCompanyEmail() && email() == userEmail && soloActualizaFoto());
      allow delete: if isSuperAdmin();
    }

    // Apariencia (tema/modo/logo) — org-wide.
    match /config/{doc} {
      allow read: if isProvisioned();
      allow write: if isSuperAdmin();
    }

    match /syncMeta/{doc} {
      allow read: if isProvisioned();
      allow write: if false; // solo Cloud Functions
    }

    // Tableros tipo Notion — espacio de trabajo propio del equipo, independiente de Zoho.
    // Cualquier persona provisionada puede crear/editar (es un espacio compartido, no privado).
    match /notionTableros/{tableroId} {
      allow read, write: if isProvisioned();

      match /filas/{filaId} {
        allow read, write: if isProvisioned();
      }
    }
  }
}
