# Copiar a .env (para emuladores) y a .env.<project-id> (para producción). Nunca commitear el real.

# App OAuth registrada en Zoho API Console (console.zoho.com) — tipo "Server-based Applications"
ZOHO_CLIENT_ID=
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
# Ajustar dominio si el portal está en otro data center (.eu, .in, .com.cn, .com.au)
ZOHO_API_BASE=https://projectsapi.zoho.com/restapi
ZOHO_REDIRECT_URI=https://TU-PROJECT-ID.web.app/api/zohoOAuthCallback

ZOHO_PORTAL_ID=824013132
ZOHO_PROJECT_ID=2171959000001008161

FRONTEND_URL=https://TU-PROJECT-ID.web.app

# Secretos (NO van aquí en producción — se registran con:
#   firebase functions:secrets:set ZOHO_CLIENT_SECRET
#   firebase functions:secrets:set ZOHO_SYNC_REFRESH_TOKEN
# Para emulador local sí puedes ponerlos en este .env (que está en .gitignore).
ZOHO_CLIENT_SECRET=
# Refresh token de una cuenta de servicio (no de un usuario cualquiera) con scope de
# ZohoProjects.tasks.READ + ZohoProjects.projects.READ, generado una sola vez a mano
# siguiendo el flujo OAuth de Zoho y guardado aquí para que el sync programado no dependa
# de que alguien tenga sesión abierta.
ZOHO_SYNC_REFRESH_TOKEN=
